[Unit]
Description=Mi Cartera - activador manual privado de GitHub Actions
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=juanma
Group=juanma
WorkingDirectory=/home/juanma/cartera-trigger
EnvironmentFile=/home/juanma/cartera-trigger/tailscale.env
ExecStart=/usr/bin/python3 /home/juanma/cartera-trigger/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
